# Published host ports. Containers communicate using the service names in
# docker-compose.yml, so these values only affect host access.
ENV=nonprod
APP_PORT=3000
MCP_PORT=8000
MODEL_PORT=8001
POSTGRES_PORT=5432

# Local development database credentials. Replace these for any shared or
# deployed environment and keep the real .env file out of version control.
POSTGRES_DB=remymy
POSTGRES_USER=remymy
POSTGRES_PASSWORD=remymy_dev_password
NODE_ENV=development
