# Published host ports. Containers communicate using the service names in
# docker-compose.yml, so these values only affect host access.
ENV=nonprod
APP_PORT=3000
MCP_PORT=8000
MODEL_PORT=8001
POSTGRES_PORT=5432

# Local development database credentials. Replace these for any shared or
# deployed environment and keep the real .env file out of version control.
POSTGRES_DB=remymy
POSTGRES_USER=remymy
POSTGRES_PASSWORD=remymy_dev_password
NODE_ENV=development

REMYMY_EVAL_ENABLED=true
REMYMY_EVAL_SAMPLE_RATE=1
REMYMY_EVALUATION_TOKEN=
REMYMY_EVALUATION_DB=/app/target/evaluations.sqlite3
REMYMY_EVAL_K=6
REMYMY_POOL_SIZE=500
REMYMY_COLLABORATIVE_WEIGHT=0.75
REMYMY_DATA_VERSION=1.0
RECIPE_CATALOG_PATH=/data/RAW_recipes.csv
MODEL_ARTIFACT_PATH=/models/hybrid-foodcom.npz

JEV_API_KEY=
